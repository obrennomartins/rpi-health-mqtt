<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>rpi-health-mqtt third-party licenses</title>
  <style>
    body { font-family: sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 60rem; padding: 0 1rem; }
    pre { border: 1px solid #bbb; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <main>
    <h1>Third-party licenses</h1>
    <p>This report contains the license texts for Rust dependencies distributed with rpi-health-mqtt.</p>
    <h2>License index</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>
    {{#each licenses}}
    <section>
      {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
      <h3>Used by</h3>
      <ul>
        {{#each used_by}}
        <li>{{crate.name}} {{crate.version}}</li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
